# Copy to .env.local and fill in. .env.local is gitignored.
#
# The optional assistant proxy lives in server.js. It is the only
# component that ever holds a credential; the browser calls
# /api/ai and never sees the key.
#
# Leave this blank to run the tool with no assistant. The rule-based
# verdict is complete without it.
OPENROUTER_API_KEY=

# ONLY free OpenRouter models are used. Any id not ending in ":free"
# is ignored by the server, so a paid model can never be selected.
#
# Preferred model, tried first when it fits the request. Leave blank
# to let the router choose purely by request size.
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional attribution origin for OpenRouter.
# AI_ORIGIN=http://localhost:8080
